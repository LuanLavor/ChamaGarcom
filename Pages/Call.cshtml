@page
@model ChamaGarcom.Pages.CallModel
@{
    ViewData["Title"] = "Chamar Garçom";
}

<div class="container vh-100 d-flex justify-content-center align-items-center">
    <div class="card shadow-lg text-center p-4" style="max-width: 380px; width: 100%;">

        <h3 class="mb-3">🧾 Mesa @Model.TableNumber</h3>

        <p class="text-muted">
            Clique no botão abaixo para chamar o garçom.
        </p>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info">
                @Model.Message
            </div>
        }

        <form method="post">
            <input type="hidden" name="tableId" value="@Model.TableId" />

            <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
                🔔 Chamar Garçom
            </button>
        </form>

        <small class="text-muted d-block mt-4">
            Atendimento por ordem de chegada
        </small>
    </div>
</div>
